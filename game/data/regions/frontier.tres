[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/region_layout.gd" id="1"]

[resource]
script = ExtResource("1")
home_id = "r_home"
march_ticks = 360
regions = {
"r_home": {"title": "边境镇", "position": Vector2i(7, 7), "visibility": "scouted", "owner": "player", "access": "open", "description": "领地首府，可进入城镇建造、生产和管理部队。"},
"r_woods": {"title": "北部林地", "position": Vector2i(392, 42), "visibility": "known", "owner": "", "access": "blocked", "description": "林道尽头的木寨村落，设有农牧区、粮仓和补给市场。可派现役军团前往侦察。"},
"r_fort": {"title": "旧堡", "position": Vector2i(539, 260), "visibility": "hidden", "owner": "", "access": "blocked", "description": "兼有驻军与居民的石墙小镇。从北部林地发现，通行需先取得林地控制权。"}
}
roads = Array[PackedStringArray]([PackedStringArray("r_home", "r_woods"), PackedStringArray("r_woods", "r_fort")])
