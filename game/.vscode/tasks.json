{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Godot: smoke test",
      "type": "process",
      "command": "${config:godotTools.editorPath.godot4}",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "--script",
        "res://tests/smoke_test.gd"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Godot: SQLite test",
      "type": "process",
      "command": "${config:godotTools.editorPath.godot4}",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "--script",
        "res://tests/sqlite_test.gd"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Godot: all tests",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Godot: SQLite test",
        "Godot: smoke test",
        "Godot: strategic test",
        "Godot: world UI test"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Godot: build Windows",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/../tools/build_windows.ps1"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Godot: strategic test",
      "type": "process",
      "command": "${config:godotTools.editorPath.godot4}",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "--script",
        "res://tests/strategic_test.gd"
      ],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Godot: world UI test",
      "type": "process",
      "command": "${config:godotTools.editorPath.godot4}",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "--script",
        "res://tests/world_scene_test.gd"
      ],
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
